# =============================================================================
# THEME
# =============================================================================
DARK = {
    "bg"        : "#0d1117",
    "panel"     : "#161b22",
    "grid"      : "#21262d",
    "text"      : "#e6edf3",
    "subtext"   : "#8b949e",
